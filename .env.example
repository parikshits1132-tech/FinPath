# FinPath Environment Configuration (Template - do NOT put real secrets here)
ENV=dev

# Postgres Superuser / Migration credentials (local dev defaults)
POSTGRES_USER=finpath
POSTGRES_PASSWORD=finpath_dev_password
POSTGRES_DB=finpath

# Non-superuser application role used by FastAPI (enforces RLS)
APP_DB_USER=finpath_app
APP_DB_PASSWORD=finpath_app_dev_password

# Connection strings (Docker Compose network host = postgres)
DATABASE_URL=postgresql+asyncpg://finpath_app:finpath_app_dev_password@postgres:5432/finpath
MIGRATION_DATABASE_URL=postgresql+psycopg://finpath:finpath_dev_password@postgres:5432/finpath

# Auth / JWT (replace in non-dev environments)
JWT_SECRET_KEY=dev-only-change-me-before-production-minimum-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
